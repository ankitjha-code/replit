{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "moduleResolution": "Bundler"
  },
  "include": ["src/**/*"],

  "exclude": ["node_modules", "dist", "src/generated"]
}
