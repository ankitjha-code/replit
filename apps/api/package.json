{
  "name": "@platform/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json && node ../../scripts/copy-generated.mjs",
    "dev": "prisma generate && tsx watch src/index.ts",
    "worker": "prisma generate && tsx watch src/worker.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "operator:grant": "tsx src/scripts/grant-operator.ts",
    "secrets:rotate": "tsx src/scripts/rotate-secrets.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "db:deploy:prod": "prisma migrate deploy"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "@platform/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dockerode": "^5.0.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "isomorphic-git": "1.42.2",
    "lib0": "^0.2.117",
    "memfs": "4.51.1",
    "minio": "^8.0.7",
    "nodemailer": "^10.0.9",
    "pg": "^8.23.0",
    "pino": "^9.13.1",
    "pino-http": "^10.5.0",
    "prisma": "7.10.0",
    "prom-client": "^15.1.3",
    "tar-stream": "^3.2.1",
    "ws": "^8.21.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.5",
    "@types/node": "^22.18.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@types/tar-stream": "^3.1.4",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
