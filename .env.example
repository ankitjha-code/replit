# =============================================================================
# Local development configuration.
#
#   cp .env.example .env      (or just run `pnpm infra:up`, which does it)
#
# Never commit .env. Values here are development defaults, deliberately
# obvious; every secret-shaped entry must be replaced before running outside
# your machine.
#
# This file is read by both the application and Docker Compose, so it is the
# single authoritative port map.
# =============================================================================

NODE_ENV=development

# --- Control plane (API) -----------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Public origin of the browser application. Separate from the API's because the
# links the platform mails out are opened by a person and must land on a page,
# not on an endpoint. Behind the proxy these are the same origin; in development
# they are not.
WEB_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
TRUST_PROXY=false

LOG_LEVEL=debug
LOG_PRETTY=true

# Registration attempts per client address per window. Low on purpose: a person
# signs up once, so anything above a handful is either a mistake or an attempt
# to find out which addresses already have accounts.
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=900000

# Sign-in attempts per client address per window. Higher than registration
# because mistyping a password is normal, but still bounded: this is the
# endpoint used to guess credentials, and every attempt costs a key derivation.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# Projects created per account per window.
RATE_LIMIT_PROJECT_CREATE_MAX=20
RATE_LIMIT_PROJECT_CREATE_WINDOW_MS=3600000

# Projects one account may own. Every project becomes a container and a
# filesystem once execution lands, so this is a resource ceiling rather than a
# product tier.
MAX_PROJECTS_PER_USER=50

# --- Project files -----------------------------------------------------------
# Source files live in the platform database, so these bound that table rather
# than a disk. Large binaries belong in project asset storage, which has its
# own lifecycle.
FILE_MAX_BYTES=1048576
PROJECT_MAX_BYTES=67108864
PROJECT_MAX_FILES=5000

# --- Runtimes ----------------------------------------------------------------
# A runtime is the container backing one project's workspace. The control plane
# records what should exist; an execution provider makes it so.

# Which execution backend runs project code. `none` is the only value that
# exists today, and it is honest rather than degraded: the platform records
# runtimes and refuses to start them, saying why. A value is added here only
# when a provider for it exists, so a configured backend can never quietly fall
# back to doing nothing.
EXECUTION_PROVIDER=none

# Which backend builds and serves deployments. `execution` builds in the same
# container plane that runs development runtimes, and needs EXECUTION_PROVIDER
# set to something real as well. `none` records the deployment model and refuses
# to build, saying why.
#
# Opt in rather than inferred from the execution provider: deploying means
# serving somebody's code to the public on an open port, with no account needed
# to reach it, and an installation should have to say it wants that.
DEPLOYMENT_PROVIDER=none

# Deployments one project may keep. Each holds a snapshot of the project's
# source, so the history is not free. The oldest stopped ones are pruned, and
# nothing that is serving is ever pruned.
MAX_DEPLOYMENTS_PER_PROJECT=20

# Where deployed projects are served. A separate listener on a separate port,
# one hostname per project, for the same reason previews have one: what it
# serves is code the platform did not write, and on the platform's own origin it
# could act as whoever opened it. Unlike a preview, this one is public.
DEPLOYMENT_PORT=4200
# The suffix a project's deployment label sits under. Through the proxy this is
# `app.localhost:8080`; addressed directly it is `localhost:4200`. Set it to
# whichever address people will actually open, because it is what the platform
# tells them their site is at.
DEPLOYMENT_HOST_SUFFIX=app.localhost:8080
DEPLOYMENT_SCHEME=http

# --- Background work ----------------------------------------------------------
# Starting a runtime pulls an image and building a deployment installs
# dependencies. Both used to happen inside the request that asked for them. They
# are now recorded as jobs and done by a worker.
#
# The jobs are rows in the platform's own database, which is what makes them
# durable and claimable exactly once. Redis is optional and is not a store: all
# it carries is a nudge saying there is work, so a worker in another process
# reacts immediately instead of on its next poll. Bring it up with
# `docker compose --profile queue up -d redis`.
# REDIS_URL=redis://127.0.0.1:6389
REDIS_JOB_CHANNEL=platform:jobs

# How often a running job is touched to say the worker is still here, and how
# long it may go untouched before it is assumed abandoned. The heartbeat is
# comfortably shorter than the threshold: one missed beat must not be enough to
# take work away from a worker that is still doing it. The reaper is what stands
# between a worker being killed and a job sitting in RUNNING for ever.
JOB_HEARTBEAT_MS=10000
JOB_STALE_AFTER_MS=60000
JOB_REAP_INTERVAL_MS=30000

# Whether this process does the work as well as accepting it. True is the
# single-process arrangement everything else here assumes; set it false when
# running `pnpm --filter @platform/api worker` as its own process.
JOB_WORKER_ENABLED=true

# How often a worker looks for work regardless of nudges. This is the reason
# losing the queue costs latency rather than correctness.
JOB_POLL_INTERVAL_MS=2000

# How many times a job is tried, and how long it waits between attempts. A job
# that failed because something was briefly unavailable succeeds on the next
# attempt; one that is broken fails again immediately, and backing off stops it
# occupying a worker in a tight loop.
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_MS=5000
JOB_RETRY_MAX_MS=120000

# How long a worker waits for one job. Generous, because the jobs are an image
# pull and a dependency install. What ends here is the worker's willingness to
# wait and not the work itself: a timed-out build may still be running.
JOB_TIMEOUT_MS=1200000

# How many of a project's jobs a listing returns.
JOB_LIST_LIMIT=20

# How many of each kind of job may run at once across every worker. 0 is no
# limit. Builds are the one worth capping: each is a container installing
# dependencies. Starting an environment always goes ahead of a build.
JOB_CONCURRENCY_RUNTIME_START=0
JOB_CONCURRENCY_DEPLOYMENT_BUILD=0

# Deployment alerts, checked by the worker process (`pnpm dev:worker`) for
# projects that turned them on. Mail needs SMTP_* configured and a confirmed
# owner address; without either, alerts are recorded but not sent.
ALERT_CHECK_INTERVAL_MS=60000
ALERT_BATCH=50
ALERT_EVENTS_SHOWN=20

# How often a workload's resource use is measured, and how many readings the
# trend holds. A reading is taken when somebody asks for one, throttled by this
# interval so two people watching one project cost the same as one. The window
# is held in memory: it starts when the control plane starts and is gone when
# the process is.
MONITORING_SAMPLE_INTERVAL_MS=5000
MONITORING_HISTORY_SAMPLES=60

# What a project's health check asks for, until the project says otherwise. "/"
# is the wrong answer for plenty of applications, so it is a default and not a
# rule: an API serving no page at its root would otherwise be reported unhealthy
# for doing exactly what it was written to do.
HEALTH_CHECK_DEFAULT_PATH=/
HEALTH_CHECK_DEFAULT_TIMEOUT_MS=3000

# Custom domains one project may hold, and how domain verification asks DNS.
# Verification is bounded in time because a name whose servers do not answer
# would otherwise hold the request somebody is waiting on. Leave the servers
# empty to use the system's own; set them when this host resolves internal
# names differently from the public internet.
MAX_DOMAINS_PER_PROJECT=5
DOMAIN_DNS_TIMEOUT_MS=5000
DOMAIN_DNS_SERVERS=

# Lines of output one project keeps, and how they are written. A number of
# lines rather than a length of time: the platform promises the last N lines,
# which is a promise it can keep, and a project that printed nothing for a month
# would otherwise have its log emptied for being quiet.
PROJECT_LOG_RETAINED_LINES=20000
PROJECT_LOG_FLUSH_MS=1000
PROJECT_LOG_FLUSH_LINES=200

# What a deployment is allowed of the machine. Separate from the development
# runtime's ceilings: a runtime exists while somebody watches it, a deployment
# runs unattended for as long as it is up.
DEPLOYMENT_CPU_MILLICORES=1000
DEPLOYMENT_MEMORY_MB=512
DEPLOYMENT_PIDS_LIMIT=256

# How long a build may run before it is abandoned, and how long a started
# server has to answer on a port before it is called failed. Nothing is reported
# running until something responds to a real HTTP request.
DEPLOYMENT_BUILD_TIMEOUT_MS=900000
DEPLOYMENT_READY_TIMEOUT_MS=60000
DEPLOYMENT_PROBE_TIMEOUT_MS=1000

# Ceilings on what a build may hand back, and how much of its output is kept to
# show afterwards. Reaching one is a refusal rather than a truncation: half a
# site served as a whole one is worse than a build that says it produced too
# much. The log keeps its tail, because a build fails at the end.
DEPLOYMENT_MAX_ARTIFACT_BYTES=134217728
DEPLOYMENT_MAX_FILE_BYTES=33554432
DEPLOYMENT_MAX_FILES=20000
DEPLOYMENT_MAX_LOG_BYTES=262144

# How much unpacked static output is held in memory across every deployment.
# The least recently used site is dropped and re-read when this is reached.
DEPLOYMENT_STATIC_CACHE_BYTES=268435456

# The machines that may run workloads, as JSON. Unset means one host using the
# socket below, which is what a single-machine installation has always had.
#
#   EXECUTION_HOSTS=[{"name":"a","cpuMillicores":4000,"memoryMb":8192},
#                    {"name":"b","url":"tcp://10.0.0.5:2375","cpuMillicores":8000,"memoryMb":16384}]
#
# Capacity is declared rather than measured: a machine's own total includes
# whatever else runs there, and scheduling against it would fill a host that was
# already busy. A host with "schedulable": false keeps what it has and takes
# nothing new, which is how one is drained for maintenance.
#
# A malformed list refuses to start, rather than silently running one host.
# EXECUTION_HOSTS=

# How many workloads one host may carry when no host list is declared, and what
# the implicit host's processor and memory budgets are derived from. A guess
# about a machine nobody described; an installation that cares sets
# EXECUTION_HOSTS and stops guessing.
MAX_WORKLOADS_PER_HOST=20

# How much of the platform one account may be using at once. Different in kind
# from every other limit here, which bound the size of one thing: these bound how
# many things at once, which is the only kind of limit that stops one account
# filling a machine everybody shares. Charged to the project's owner.
#
# Builds are limited more tightly than deployments because they are not the same
# cost: a running deployment is a container sitting there, and a build is a
# machine installing dependencies flat out.
MAX_CONCURRENT_RUNTIMES_PER_USER=3
MAX_CONCURRENT_DEPLOYMENTS_PER_USER=5
MAX_CONCURRENT_BUILDS_PER_USER=2

# Kernel ceilings on a workload, beside the container runtime's own, and how
# much writable temporary space it gets. A descriptor leak exhausts a host long
# before it exhausts a memory limit, and it does it to every other container on
# the machine. /tmp is a bounded tmpfs mounted nosuid and nodev, so what is
# written there cannot become a setuid binary and goes when the container does.
RUNTIME_MAX_OPEN_FILES=8192
RUNTIME_TMP_MB=256

# Where the Docker daemon listens. Leave unset for a normal local install,
# where the platform's own default socket is right. This is the control plane's
# connection to the daemon, and it is never passed to a workload: a container
# that can reach this socket can create a privileged container and take the
# host.
# DOCKER_SOCKET_PATH=

# The name each project's own network is derived from: `<prefix>-<project id>`.
#
# Away from the platform's, because a workload sharing a network with the
# control plane could reach its database directly. And one per project rather
# than one for all of them, because everything on a bridge network can reach
# everything else on it by name — a single shared network would let any project's
# code connect to every other project's container, which is not a privilege that
# could be dropped but a route that has to be absent.
#
# The project database server is attached to each project network deliberately,
# which is what puts back the one route a project is supposed to have.
RUNTIME_NETWORK=platform-runtimes

# Where a project's files live inside its container.
RUNTIME_WORKSPACE_PATH=/workspace

# How long an image pull may take before it is abandoned.
RUNTIME_IMAGE_PULL_TIMEOUT_MS=300000

# How long a "can the daemon be reached" answer is reused. Every workspace page
# asks, and a ping per page view buys nothing.
RUNTIME_AVAILABILITY_TTL_MS=5000

# Resource ceiling applied to every runtime. A development environment with no
# ceiling lets one project take the machine from every other project on it. The
# process limit is separate because neither a CPU share nor a memory cap stops
# a fork bomb.
RUNTIME_CPU_MILLICORES=1000
RUNTIME_MEMORY_MB=1024
RUNTIME_PIDS_LIMIT=256

# How long a runtime is given to shut down before it is killed.
RUNTIME_STOP_GRACE_SECONDS=10

# Start and stop requests per account per window. Starting a container is the
# most expensive thing a request can ask for.
RATE_LIMIT_RUNTIME_CONTROL_MAX=30
RATE_LIMIT_RUNTIME_CONTROL_WINDOW_MS=600000

# Terminals one project may have open at once. Each is a shell inside the
# container and a socket held open here.
MAX_TERMINALS_PER_PROJECT=5

# How often a silent terminal socket is checked for still being there. A tab
# closed by a laptop lid leaves a socket that looks open from the server.
TERMINAL_HEARTBEAT_MS=30000

# How much of what a project's application printed is kept for a console that
# opens after it started. In memory and bounded: this is a window onto a
# running program, not a log. When older lines have been dropped the platform
# says so rather than presenting a partial log as a whole one.
RUN_OUTPUT_BUFFER_BYTES=262144
RUN_OUTPUT_BUFFER_LINES=2000

# Read-only output sockets one project may have open at once. Separate from the
# terminal limit: watching output costs far less than holding a shell.
MAX_OUTPUT_WATCHERS_PER_PROJECT=10

# Files one project may have open for collaborative editing at once, and editors
# attached across everybody in it. One file open in ten windows is one document
# and ten editors, and the two cost different things.
MAX_OPEN_DOCUMENTS_PER_PROJECT=20
MAX_DOCUMENT_EDITORS_PER_PROJECT=50

# How long after the last keystroke a shared document is written back to the
# project's files, and how long typing may continue before it is written back
# regardless. The second is not redundant: without it, somebody typing without
# pause has nothing written down for as long as they keep typing, and a shared
# document lives only in memory until it is.
DOCUMENT_SAVE_DEBOUNCE_MS=1500
DOCUMENT_SAVE_CEILING_MS=10000

# Event-and-presence connections one project may have at once, counted across
# everybody in it rather than per person. What it bounds is the broadcast: the
# roster goes to everyone whenever anyone arrives, leaves or changes file, so the
# cost of a room grows with the square of the windows open on it.
MAX_EVENT_WATCHERS_PER_PROJECT=25

# How much of what a shell printed is kept so its screen can be rebuilt when
# someone reattaches. Per session, and in memory: a terminal that survives a
# reload is only useful if what was on it survives too, and a runaway process
# printing forever must not be able to grow this without limit.
TERMINAL_SCROLLBACK_BYTES=131072

# How long a terminal nobody is attached to is kept before it is closed. Long
# enough to cover a reload, a tab restored after lunch, or a laptop that was
# shut. Not indefinite: a shell nobody will ever attach to again is a process
# nobody will ever stop.
TERMINAL_SESSION_IDLE_MS=1800000

# --- Previews ----------------------------------------------------------------
# A project's own application, served to a browser. On its own listener and its
# own hostname per project: whatever a project serves is code the platform did
# not write, and on the platform's origin it could act as the person looking at
# it.

# The preview listener. Separate from the API's and from the web app's.
PREVIEW_PORT=4100

# A project's preview lives at `<project id>.<suffix>`. Names under `localhost`
# resolve to loopback in every browser without any DNS.
PREVIEW_HOST_SUFFIX=localhost:4100

# `https` once there is a certificate. Note that a preview can only be shown
# inside the workspace over HTTPS: its cookie is a third-party cookie in a
# frame, and browsers send one only when it is Secure. Over plain HTTP the
# workspace says so and opens previews in a tab.
PREVIEW_SCHEME=http

PREVIEW_COOKIE_NAME=platform_preview

# How long a preview link may be exchanged for a cookie. Short: it is redeemed
# within a second of being issued, and it travels in an address.
PREVIEW_GRANT_TTL_SECONDS=60

# How long a browser may keep viewing before it asks again.
PREVIEW_SESSION_TTL_SECONDS=28800

# How long to wait for a port to answer while looking for the application.
PREVIEW_PROBE_TIMEOUT_MS=1000

# --- Project files and secrets -----------------------------------------------

# Largest single upload, and the total one project may store. Uploads are held
# in memory while being hashed, so the first is a memory ceiling as well.
ASSET_MAX_BYTES=26214400
PROJECT_ASSET_MAX_BYTES=262144000

# How long a "can the file store be reached" answer is reused.
STORAGE_AVAILABILITY_TTL_MS=5000

# The key project secrets are encrypted with: 32 bytes, base64. Generate one
# with `openssl rand -base64 32`. Losing it loses every secret stored under it,
# which is the intended property. Unset means the platform cannot store secrets
# and says so, rather than storing them in the clear.
# SECRETS_ENCRYPTION_KEY=

# Most secrets one project may hold. Every one is injected at every start.
# --- Snapshots and history ----------------------------------------------------
# Both keep archives in object storage, so both need STORAGE_* configured.

# Snapshots one project may keep. Each is a whole copy of the project's source,
# so a feature whose cost grows without limit is one nobody can plan for.
MAX_SNAPSHOTS_PER_PROJECT=25
SNAPSHOT_MAX_BYTES=67108864

# Snapshots the platform keeps on a project's behalf, one taken immediately
# before each restore so that a restore can be undone. Counted separately from
# the allowance above, and pruned oldest-first: refusing to let somebody go back
# because they had used up their snapshots would be the worst possible moment to
# enforce a quota.
MAX_AUTOMATIC_SNAPSHOTS_PER_PROJECT=3

# How much history one listing returns.
GIT_HISTORY_LIMIT=50

# Git remotes. The control plane makes these requests to addresses users type,
# so by default only https to public addresses is allowed. Turning either on for
# a self-hosted forge also lets any project owner make this server reach that
# network — plain http, or private/loopback addresses respectively.
GIT_REMOTE_ALLOW_HTTP=false
GIT_REMOTE_ALLOW_PRIVATE=false
GIT_REMOTE_TIMEOUT_MS=60000

# The largest packed repository this installation will store. Every commit
# rewrites the whole archive, so this bounds the cost of making one as well as
# the cost of keeping it.
GIT_MAX_REPOSITORY_BYTES=134217728

# Plain environment variables one project may hold. Bounded for the same
# reason secrets are: every one is injected into every container start.
MAX_VARIABLES_PER_PROJECT=100

# --- The database a project's application gets --------------------------------
# A second PostgreSQL server, not a second database inside the platform's. The
# platform's users, sessions and secrets are in a different server process, so a
# project's SQL reaches nothing of the platform's because there is nothing of
# the platform's there to reach.

USER_DATABASE_PORT=5452
USER_DATABASE_ADMIN_USER=userdb_admin
USER_DATABASE_ADMIN_PASSWORD=userdb_dev_only

# How the control plane provisions: over loopback, as an administrator. Unset
# means the platform cannot give a project a database and says so.
USER_DATABASE_ADMIN_URL=postgresql://userdb_admin:userdb_dev_only@127.0.0.1:5452/postgres

# How an application reaches it from inside its container: by container name on
# the runtime network. A container cannot reach the platform's loopback, and
# would not be given administrator credentials if it could.
USER_DATABASE_CONTAINER_HOST=platform-userdb
USER_DATABASE_CONTAINER_PORT=5432

MAX_SECRETS_PER_PROJECT=100

# --- Sessions ----------------------------------------------------------------
SESSION_COOKIE_NAME=platform_session

# Hard lifetime: a session stops working at this point however active it has
# been, so a stolen cookie is not useful forever.
SESSION_ABSOLUTE_TTL_HOURS=720

# Idle lifetime: an unused session expires sooner, which is what closes an
# abandoned browser on a shared machine.
SESSION_IDLE_TTL_HOURS=168

# Minimum gap between last-seen writes, so an authenticated request is not also
# a database write.
SESSION_LAST_SEEN_THROTTLE_SECONDS=60

# Marks the cookie Secure. Defaults on outside development; leave unset unless
# you are running local HTTPS. Turning it off in production sends sessions in
# the clear.
# SESSION_COOKIE_SECURE=

# --- Web client --------------------------------------------------------------
# Binds all interfaces so the containerised reverse proxy can reach the dev
# server. Set to 127.0.0.1 if you do not use the proxy.
VITE_HOST=0.0.0.0
VITE_PORT=5173
VITE_API_PROXY_TARGET=http://localhost:4000
# Leave empty to call the API same-origin through the dev proxy.
VITE_API_BASE_URL=

# =============================================================================
# Infrastructure (docker compose -f infra/docker-compose.yml)
#
# Ports avoid the common defaults (5432, 6379, 9000) so an unrelated local
# stack keeps working. Every service binds to 127.0.0.1 only.
# =============================================================================

# --- PostgreSQL: the platform database ---------------------------------------
# Holds users, projects, permissions, file and runtime metadata. This is NOT
# the database a user's application gets; that is provisioned separately.
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_dev_only
POSTGRES_DB=platform
POSTGRES_PORT=5442
DATABASE_URL=postgresql://platform:platform_dev_only@localhost:5442/platform?schema=public

# Connection pool. Sized against the server's max_connections, not against
# expected traffic: exceeding the ceiling fails requests rather than queueing.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
# Postgres aborts a query that outlives this, freeing the pooled connection.
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Integration tests create and migrate this database automatically, so they
# never truncate your working data. Change the name only if it collides.
TEST_DATABASE_NAME=platform_test

# --- MinIO: object storage for project assets --------------------------------
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
STORAGE_ENDPOINT=http://localhost:9100
STORAGE_ACCESS_KEY=platform
STORAGE_SECRET_KEY=platform_dev_only
STORAGE_BUCKET=platform-assets

# --- Custom domains that stop pointing here ---------------------------------
# Verification proves control once; a domain can be sold or repointed later.
# The worker re-checks verified domains and retires one only after this many
# misses in a row, so one bad DNS lookup never takes a site down.
DOMAIN_RECHECK_AFTER_MS=21600000
DOMAIN_RECHECK_MISSES=3
DOMAIN_RECHECK_BATCH=50

# --- Project networks -------------------------------------------------------
# Every project gets its own Docker network, which is what stops one project
# reaching another. Left to itself Docker gives each network a large subnet from
# a pool that runs out at about thirty — after which NO project can start. The
# platform carves small subnets from this range instead: a /16 in /28s is 4,096
# project networks. Pick a range nothing else on the host uses.
RUNTIME_NETWORK_POOL=10.210.0.0/16
RUNTIME_NETWORK_PREFIX_LENGTH=28

# Whether preview ports are published on the host. A published port is reachable
# from containers on OTHER Docker networks, so publishing lets any project reach
# any other project's running app. `auto` publishes only on Docker Desktop, where
# the host cannot reach a container any other way; on Linux nothing is published.
# Never set `always` on a machine serving more than one person.
RUNTIME_PUBLISH_PORTS=auto

# --- Workloads run unprivileged - Task 63 ------------------------------------
# The largest thing every other hardening measure does not fix: capabilities can
# all be dropped and the process inside is still uid 0. Numeric rather than a
# name, because a name has to exist in the image's own passwd file and does not
# exist in all of them.
RUNTIME_WORKLOAD_UID=1000
RUNTIME_WORKLOAD_GID=1000
# A writable home outside the project's files. Package managers write caches
# into $HOME, and a non-root workload without a writable one cannot install a
# dependency — which is the failure that makes somebody turn this off.
RUNTIME_WORKLOAD_HOME=/home/workload
# The escape hatch, for an image that genuinely cannot run unprivileged. Set it
# and the whole measure is off, visibly, in one place.
RUNTIME_RUN_AS_ROOT=false

# --- Database backups - Task 64 ----------------------------------------------
# pg_dump runs in a container, never on the host: the platform may not execute a
# command on its own machine, and that rule has no exception for tools it trusts.
# The image's major version should be at least the project database server's.
DATABASE_BACKUP_IMAGE=postgres:17-alpine
DATABASE_BACKUP_TIMEOUT_MS=600000
MAX_DATABASE_BACKUPS_PER_PROJECT=10
DATABASE_BACKUP_LIST_LIMIT=50

# --- Mail: address verification and password reset - Task 60 -----------------
# SMTP rather than a mail API: every hosted service has its own SDK and account,
# and picking one would make a paid third party part of running this platform.
# Point this at the Mailpit container that `pnpm infra:up` starts, at a company
# relay, or at any commercial service — the platform cannot tell the difference.
#
# With SMTP_HOST or MAIL_FROM empty, the platform reports that it cannot send
# mail and offers verification and password reset as unavailable, rather than
# failing when somebody tries them.
SMTP_HOST=localhost
SMTP_PORT=1025
# TLS from the first byte (port 465). False still upgrades with STARTTLS when
# the server offers it, which is what a submission port on 587 does.
SMTP_SECURE=false
# Empty for the local mail container, which wants no credentials at all.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=platform@localhost
SMTP_TIMEOUT_MS=10000
MAIL_AVAILABILITY_TTL_MS=30000

# Where the Mailpit container listens, and where to read what it caught:
# http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# A verification link proves an address and grants nothing, so it can last a
# day. A reset link IS the password for as long as it lives.
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
# How many links of one kind one account may be sent per window. Beside the
# per-address route limiter below, and stopping something different: that stops
# one client hammering the endpoint, this stops many clients doing it to one
# person.
MAIL_TOKENS_PER_WINDOW=5
MAIL_TOKEN_WINDOW_MINUTES=60
RATE_LIMIT_MAIL_MAX=5
RATE_LIMIT_MAIL_WINDOW_MS=900000

# --- Cleanup and recovery - Task 57 / Task 58 --------------------------------
# Every leak the sweep removes exists because somewhere a failure was preferred
# over blocking: a project is deleted even when the host holding its container
# is unreachable. This is the other half of that bargain.
#
# Runs in the worker process only, never in the API. Two workers sweeping at
# once is harmless; several API instances doing it would be several processes
# enumerating and deleting the same containers.
# How long the boot-time reconciliation may take before the process stops
# waiting for it. The work is not cancelled; the platform simply starts.
RECOVERY_TIMEOUT_MS=30000

ORPHAN_SWEEP_ENABLED=true
ORPHAN_SWEEP_INTERVAL_MS=3600000
# How old something must be before it counts as abandoned. The most important
# number here: a container exists for a moment before the row recording it does,
# and an hour of slack makes that ordinary race impossible to mistake for a leak.
ORPHAN_GRACE_MINUTES=60
# Report what would be removed and remove nothing. Worth leaving on for a while
# on a new installation.
ORPHAN_SWEEP_DRY_RUN=false

# --- Account management - Task 59 --------------------------------------------
# Changing a password and closing an account both sit behind a live session, so
# the sign-in limiter never sees them. Without a ceiling here a stolen session is
# an unlimited oracle for guessing the password protecting the account it has
# already taken.
RATE_LIMIT_ACCOUNT_MAX=5
RATE_LIMIT_ACCOUNT_WINDOW_MS=900000
# How long a wrong password waits before it is told so.
ACCOUNT_WRONG_PASSWORD_DELAY_MS=400


# --- API and socket limits - Task 54 / Task 55 -------------------------------
# A ceiling across everything under /api, keyed by account. Route-level limits
# on sign-in and project creation still apply on top of this one. /health is
# deliberately exempt: a limiter that can fail the health check turns a busy
# minute into an outage the platform declares about itself.
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
# How long a request may take before the client is told to stop waiting. The
# work is NOT cancelled - Express cannot unwind a handler from outside - and
# responses that have already started sending are exempt.
REQUEST_TIMEOUT_MS=30000
# Sockets one account may hold at once, across all four gateways.
MAX_SOCKETS_PER_USER=40
# Upgrade attempts one address may make in a window, refused or not. Generous
# on purpose: this stops a runaway reconnect loop, it does not ration a shared
# address.
MAX_SOCKET_ATTEMPTS=120
SOCKET_ATTEMPT_WINDOW_MS=60000
# Frames one socket may send. A token bucket, because a paste into a terminal is
# a legitimate burst. Over budget drops the frame; it never closes the socket.
SOCKET_MESSAGE_BURST=200
SOCKET_MESSAGES_PER_SECOND=50

# --- Object storage resilience - Task 56 -------------------------------------
# Retrying answers a blip. The breaker answers an outage, where retrying would
# make every request slow instead. Delays carry full jitter so that everything
# which failed together does not retry together.
STORAGE_RETRY_ATTEMPTS=3
STORAGE_RETRY_BASE_MS=200
STORAGE_RETRY_MAX_MS=2000
# Consecutive failures before calls stop being attempted, and how long before
# one call is let through to ask whether the store is back.
STORAGE_BREAKER_THRESHOLD=5
STORAGE_BREAKER_RESET_MS=30000

# --- Reverse proxy: preview and deployment routing ---------------------------
PROXY_HTTP_PORT=8080
PREVIEW_DOMAIN=preview.localhost
DEPLOY_DOMAIN=app.localhost
# Where the proxy finds the API and web client. They run on the host, not in
# Compose, so the container reaches them through the host gateway.
PROXY_API_UPSTREAM=host.docker.internal:4000
PROXY_WEB_UPSTREAM=host.docker.internal:5173

# --- Redis: NOT started by default -------------------------------------------
# Nothing needs a queue, pub/sub or shared presence yet. Start it the day a
# workload justifies it:  docker compose --profile queue up -d
REDIS_PORT=6389
# Leave REDIS_URL empty while Redis is not running; the platform then reports
# no Redis dependency rather than a permanently failing one.
REDIS_URL=

# =============================================================================
# Reserved for later tasks. Documented here so the configuration surface stays
# in one place.
# =============================================================================

# --- Sessions and secret encryption - Task 5 / Task 25 -----------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SESSION_SECRET=
# SECRETS_ENCRYPTION_KEY=

# --- Execution plane - Task 13 / Task 14 -------------------------------------
# DOCKER_HOST=
# RUNTIME_CPU_LIMIT=1
# RUNTIME_MEMORY_LIMIT_MB=1024
# RUNTIME_PIDS_LIMIT=256
# RUNTIME_IDLE_TIMEOUT_MINUTES=30

# --- Disk limits ---------------------------------------------------------------
# What each environment and each server deployment may write, in MB. The worker
# measures every DISK_CHECK_INTERVAL_MS and stops anything over, telling its
# owner why. DISK_LIMIT_MODE=enforce also has Docker refuse writes past the
# limit; that needs Docker on XFS with project quotas (or btrfs/zfs) — Docker's
# containerd snapshotter accepts the setting and silently ignores it.
RUNTIME_DISK_MB=2048
DEPLOYMENT_DISK_MB=2048
DISK_CHECK_INTERVAL_MS=60000
DISK_LIMIT_MODE=monitor

# --- Sandboxing ------------------------------------------------------------------
# The OCI runtime users' code runs under. Empty uses Docker's default (runc).
# `runsc` runs every workload under gVisor: install it with
# deploy/gvisor/install.sh first. The platform reports itself unavailable if the
# runtime named here is not registered with Docker.
RUNTIME_OCI_RUNTIME=

# --- Background work -----------------------------------------------------------
# Jobs (environment starts, builds) one worker process runs at once.
JOB_WORKER_CONCURRENCY=4

# --- Metrics -----------------------------------------------------------------
# Set to serve /metrics to a scraper presenting `Authorization: Bearer <token>`.
# Unset, /metrics answers 404. At least 24 characters.
METRICS_TOKEN=

