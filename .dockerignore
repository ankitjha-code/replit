# Never sent to the image build: dependencies are installed inside it, and
# secrets, local data and documentation have no business in an image.
**/node_modules
**/dist
**/*.tsbuildinfo
**/coverage
**/test-results
**/playwright-report
.git
.env
.env.*
!.env.example
deploy/production.env
docs
doc.html
*.md
!**/prisma/**/*.md
.DS_Store
.idea
.vscode
