# Production settings. Copy to deploy/production.env (never committed) and fill
# in every value marked REQUIRED. Generate secrets with the commands shown.

# --- Names --------------------------------------------------------------------
# DNS: point all four at this server's public IP.
#   A  platform.example.com
#   A  *.preview.example.com
#   A  *.app.example.com
PLATFORM_DOMAIN=platform.example.com        # REQUIRED
PREVIEW_DOMAIN=preview.example.com          # REQUIRED
APP_DOMAIN=app.example.com                  # REQUIRED
ACME_EMAIL=ops@example.com                  # REQUIRED for real certificates
TLS_MODE=acme                               # acme (real) | local (testing only)

# --- Secrets (REQUIRED) -------------------------------------------------------
# openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=
# openssl rand -hex 24   (each)
POSTGRES_PASSWORD=
USERDB_PASSWORD=
STORAGE_ACCESS_KEY=platform
STORAGE_SECRET_KEY=
# Optional: turns on /metrics for a scraper inside this deployment.
METRICS_TOKEN=

# --- The Docker socket's group on this server ---------------------------------
# stat -c %g /var/run/docker.sock
DOCKER_GID=

# --- Mail (password reset, verification, alerts). Optional but recommended. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Backups -------------------------------------------------------------------
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
# Strongly recommended: a copy off this machine. Any S3-compatible bucket.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=us-east-1

# --- Monitoring (optional: --profile monitoring) -------------------------------
# Needs METRICS_TOKEN above and the SMTP settings. Pages are on the server's
# loopback only: ssh -L 3000:127.0.0.1:3000 you@server, then open localhost:3000.
ALERT_EMAIL=
GRAFANA_ADMIN_PASSWORD=
ALERT_SMTP_REQUIRE_TLS=true
PROMETHEUS_RETENTION=30d

# --- Sandboxing (optional) ------------------------------------------------------
# runsc runs every workload under gVisor; install it first (deploy/gvisor/).
RUNTIME_OCI_RUNTIME=
# monitor (default) or enforce (needs Docker on XFS with project quotas).
DISK_LIMIT_MODE=monitor
RUNTIME_DISK_MB=2048
DEPLOYMENT_DISK_MB=2048

# --- Rarely changed ------------------------------------------------------------
STACK=platform
VERSION=latest
HTTP_PORT=80
HTTPS_PORT=443
